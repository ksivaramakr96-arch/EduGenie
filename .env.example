# =========================================================
# EduGenie Configuration
# =========================================================

# Create your own Gemini API key.
# NEVER commit the real key to GitHub.

GEMINI_API_KEY=your_gemini_api_key_here


# Gemini model
GEMINI_MODEL=gemini-3.8-flash


# =========================================================
# Optional local explanation model
# =========================================================

USE_LOCAL_EXPLANATION_MODEL=false

LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M


# =========================================================
# Application
# =========================================================

APP_NAME=EduGenie

ENVIRONMENT=development

HOST=127.0.0.1

PORT=8000

MAX_INPUT_CHARS=20000


# =========================================================
# CORS
# =========================================================

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000